{
  "name": "@canxer314/sandcastle-orchestrator",
  "version": "0.1.0",
  "description": "Single-host execution orchestrator with a Unix socket management CLI",
  "repository": "github:canxer314/sandcastle-orchestrator",
  "publishConfig": { "access": "public" },
  "bin": { "sandcastle-orchestrator": "./dist/cli.js" },
  "files": ["dist", "docs/installation.md", "docs/onboarding.md", "docs/demo.md", "docs/setup.md", "docs/connection-projection.md", "docs/issue-80-docker-acceptance.md", "docs/user-guide.md", "docs/deployment-guide.md", "docs/queries.md", "docs/submissions.md", "docs/readonly-role-tutorial.md", "examples/readonly-role", "docs/external-submission.md", "docs/issue-27-local-acceptance.md", "docs/issue-19-real-acceptance.md", "docs/issue-20-real-acceptance.md", "docs/issue-23-real-acceptance.md", "docs/issue-24-real-acceptance.md", "docs/issue-22-real-acceptance.md", "docs/issue-29-real-acceptance.md"],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx src/cli.ts",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/cli.js",
    "prepack": "pnpm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "@modelcontextprotocol/server": "2.3.1",
    "effect": "3.20.0",
    "tsx": "^4.20.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.3"
  }
}
